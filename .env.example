# Generate a private .env with: python -m app.cli init-env
TRADEORBIT_APP_ENV=local
TRADEORBIT_DATABASE_URL=postgresql+asyncpg://tradeorbit:__POSTGRES_PASSWORD__@127.0.0.1:15432/tradeorbit
TRADEORBIT_REDIS_URL=redis://127.0.0.1:16379/0
TRADEORBIT_SESSION_SECRET=__SESSION_SECRET__
TRADEORBIT_CREDENTIAL_ENCRYPTION_KEY=__ENCRYPTION_KEY__
TRADEORBIT_ENCRYPTION_KEY_VERSION=v1
TRADEORBIT_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:18080","http://127.0.0.1:18080"]
TRADEORBIT_COOKIE_SECURE=false
TRADEORBIT_TRADING_ENABLED=false
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
